# 复制为 .env 后按需修改

# 服务监听地址与端口
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# 本地数据库（SQLite）
DATABASE_PATH=./data/app.db

# 上传文件目录（经 /api/media/<filename> 访问）
UPLOADS_DIR=./uploads

# 前端静态目录
FRONTEND_DIR=./frontend

# 可选：接入真实大模型（OpenAI 兼容接口）。留空则使用本地结构化 mock。
# AI_API_KEY=sk-xxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
