#!/usr/bin/env sh
[ "$SKIP_GIT_HOOKS" = "1" ] && exit 0

# 只校验本次暂存的文件，避免被仓库中已有的历史 lint 问题卡住所有提交。
# 直接用 node 运行 eslint（绕过 Windows 下 npm 脚本解析异常，且无需依赖缺失的 precommit 脚本）。
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs')
if [ -n "$STAGED" ]; then
  ESLINT=node_modules/eslint/bin/eslint.js
  CONFIG=eslint.config.js
  if [ -f "$ESLINT" ] && [ -f "$CONFIG" ]; then
    echo "ESLint 校验暂存文件..."
    node "$ESLINT" --quiet --config "$CONFIG" $STAGED
    if [ $? -ne 0 ]; then
      echo "ESLint 未通过，请修复后再提交（或 SKIP_GIT_HOOKS=1 跳过）。"
      exit 1
    fi
  else
    echo "（未检测到 eslint 或 eslint.config.js，跳过 pre-commit 校验）"
  fi
fi
