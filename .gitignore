# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/
build/
*/build/
legacy/

# Environment files
# 真实环境文件可能含 AI_API_KEY / DATABASE_URL 等敏感或本机专属配置——严禁提交
# 仅保留 .env.example 作为公开模板
.env
.env.*
!.env.example

# Local database (libSQL / SQLite)
data/
*.db
*.sqlite
*.sqlite3

# Uploads (runtime media written by Multer)
uploads/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/logs/
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary folders
tmp/
temp/
.playwright-cli/

# Lock files (keep package-lock.json for consistent installs)
yarn.lock
pnpm-lock.yaml

# Cache files
.eslintcache
*.tsbuildinfo

# swc wasm
.swc

# Agent files
.agent/
.npm_cache

# Tooling / agent project configs (Spark, etc.) — not part of the app
.spark/
.spark_project

# Bundled portable runtimes (large binaries — do not commit; distribute by copying the folder)
/python/
/node/
/runtime/

# Legacy NestJS + React implementation, kept for reference only
/legacy/
/legacy/**

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python virtual environments (never commit)
.venv/
venv/
env/
*.egg-info/

# 自检脚本产物
e2e-report.txt
