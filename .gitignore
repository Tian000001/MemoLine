# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/
build/
*/build/

# Environment files
# 真实环境文件可能含 AI_API_KEY / DATABASE_URL 等敏感或本机专属配置——严禁提交
# 仅保留 .env.example 作为公开模板
.env
.env.*
!.env.example

# Local database (libSQL / SQLite)
data/
*.db
*.sqlite
*.sqlite3

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/logs/
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
